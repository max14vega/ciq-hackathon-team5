version: v4

volumes:
  data:
    use: team5
    name: prometheus-data
    egress:
      - source:
          uri: file://results/best/best_crop_w043.png
        destination:
          uri: fb://group/prometheus/best_crop_w043.png
      - source:
          uri: file://results/best/best_full_w043.png
        destination:
          uri: fb://group/prometheus/best_full_w043.png
      - source:
          uri: file://results/best/best_crop_w024.png
        destination:
          uri: fb://group/prometheus/best_crop_w024.png
      - source:
          uri: file://results/best/best_full_w024.png
        destination:
          uri: fb://group/prometheus/best_full_w024.png
      - source:
          uri: file://results/best/best_summary.json
        destination:
          uri: fb://group/prometheus/best_summary.json

jobs:
  best:
    image:
      uri: docker://nvcr.io/nvidia/pytorch:25.10-py3
    mounts:
      /data: data
    resource:
      cpu:
        cores: 12
      memory:
        size: 48GB
      devices:
        nvidia.com/gpu: 1
    task-array:
      start: 1
      end: 2
      concurrency: 2
    script: |
      #!/bin/bash
      set -uo pipefail
      SEGS=(w043 w024)
      SEG=${SEGS[$((FB_TASK_ID-1))]}
      OUT=/data/results/best/$SEG
      mkdir -p $OUT
      source /data/venv/bin/activate
      cd /data/villa/ink-detection
      START=$(date +%s)
      python -m koine_machines.inference.infer /data/segments/$SEG/surface.zarr \
        /data/models/ink_9um/hybrid_3d2d-seed42/step-075000.pth $OUT/${SEG}__ck075k__L06-22__tta.tif \
        --no-compile --num-workers 8 --batch-size 128 --layer-start 6 --layer-end 23 \
        --tta-mirror > $OUT/log_tta.txt 2>&1
      RC=$?
      echo "seg=$SEG rc=$RC seconds=$(( $(date +%s) - START ))"
      grep -E "Selected source layer|TTA|tta|Wrote" $OUT/log_tta.txt | tail -5
      [ $RC -eq 0 ] || tail -30 $OUT/log_tta.txt
      exit $RC

  render:
    depends-on:
      - name: best
        status: FINISHED
    image:
      uri: docker://nvcr.io/nvidia/pytorch:25.10-py3
    mounts:
      /data: data
    resource:
      cpu:
        cores: 4
      memory:
        size: 48GB
    script: |
      #!/bin/bash
      set -uo pipefail
      source /data/venv/bin/activate
      cat > /tmp/r.py <<'PYEOF'
      import glob, json, os
      import numpy as np, tifffile
      from PIL import Image, ImageDraw
      Image.MAX_IMAGE_PIXELS = None
      R = os.environ.get("R", "/data/results")
      SG = os.environ.get("SG", "/data/segments")
      O = R + "/best"
      CK = ["ck010k", "ck040k", "ck075k"]
      LY = ["L04-20", "L06-22", "L08-24"]
      P = 1200
      out = {}

      def stretch(a, valid):
          lo, hi = np.percentile(a[valid], [50, 99.5])
          return np.clip((a - lo) / max(hi - lo, 1e-6), 0, 1) * valid

      def rd(p):
          return tifffile.imread(p).squeeze().astype(np.float32) / 255

      for seg in ["w043", "w024"]:
          std_run = rd(R + "/E6-bulk/" + seg + "/" + seg + "__ck075k__L06-22.tif")
          best = rd(O + "/" + seg + "/" + seg + "__ck075k__L06-22__tta.tif")
          S = np.stack([rd(R + "/E6-bulk/" + seg + "/" + seg + "__" + c + "__" + l + ".tif") for c in CK for l in LY])
          mean9 = S.mean(0)
          del S
          valid = (std_run > 0) | (best > 0)
          h, w = std_run.shape
          off = np.zeros_like(std_run)
          cands = [p for p in glob.glob(SG + "/" + seg + "/ink-detection/**/*", recursive=True)
                   if p.lower().endswith((".tif", ".tiff", ".png", ".jpg"))]
          info = {}
          if cands:
              f = max(cands, key=os.path.getsize)
              a = np.squeeze(tifffile.imread(f)) if f.lower().endswith((".tif", ".tiff")) else np.array(Image.open(f).convert("L"))
              if a.ndim == 3:
                  a = a[0] if a.shape[0] < a.shape[-1] else a[..., 0]
              a = a.astype(np.float32)
              a = a / a.max() if a.max() > 0 else a
              off = np.array(Image.fromarray((a * 255).astype(np.uint8)).resize((w, h), Image.BILINEAR), dtype=np.float32) / 255
              m = valid & (off > 0)
              for k, v in [("standard", std_run), ("tta_mirror", best), ("mean9", mean9)]:
                  info["corr_" + k + "_vs_official"] = float(np.corrcoef(v[m], off[m])[0, 1])
          sj = R + "/showcase/showcase_summary.json"
          crop = None
          if os.path.exists(sj):
              crop = json.load(open(sj)).get(seg, {}).get("crop_px")
          if not crop:
              crop = [h // 3, w // 4, h // 3 + 1000, w // 4 + 1600]
          y0, x0, y1, x1 = crop
          info["crop_px"] = crop
          panels = [("official reference", off),
                    ("ours: standard run (75k, layers 6-22)", stretch(std_run, valid)),
                    ("ours: best quality (same + mirror TTA)", stretch(best, valid)),
                    ("ours: average of 9 configurations", stretch(mean9, valid))]
          for tag, sl in [("full", (slice(None), slice(None))), ("crop", (slice(y0, y1), slice(x0, x1)))]:
              ims = []
              for t, a in panels:
                  im = Image.fromarray((np.clip(a[sl], 0, 1) * 255).astype(np.uint8))
                  im = im.resize((P, max(1, int(im.size[1] * P / im.size[0]))), Image.LANCZOS)
                  ims.append((t, im))
              hh = max(i.size[1] for _, i in ims)
              cv = Image.new("L", (2 * P, 2 * (hh + 36)), 0)
              d = ImageDraw.Draw(cv)
              for k, (t, im) in enumerate(ims):
                  x, y = (k % 2) * P, (k // 2) * (hh + 36)
                  cv.paste(im, (x, y + 36))
                  d.text((x + 10, y + 10), t, fill=255)
              cv.save(O + "/best_" + tag + "_" + seg + ".png")
          out[seg] = info
      json.dump(out, open(O + "/best_summary.json", "w"), indent=2)
      print(json.dumps(out, indent=2))
      print("wrote", sorted(f for f in os.listdir(O) if f.endswith((".png", ".json"))))
      PYEOF
      echo "lines in script: $(wc -l < /tmp/r.py) (expect 72)"
      python /tmp/r.py
