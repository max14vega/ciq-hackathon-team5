version: v4

volumes:
  data:
    use: team5
    name: prometheus-data
    egress:
      - source:
          uri: file://results/readability/ranking_tiles.csv
        destination:
          uri: fb://group/prometheus/readability_ranking_tiles.csv
      - source:
          uri: file://results/readability/ranking_files.csv
        destination:
          uri: fb://group/prometheus/readability_ranking_files.csv
      - source:
          uri: file://results/readability/ranking_label_first.csv
        destination:
          uri: fb://group/prometheus/readability_ranking_label_first.csv
      - source:
          uri: file://results/readability/gallery_top20.png
        destination:
          uri: fb://group/prometheus/readability_gallery_top20.png
      - source:
          uri: file://results/readability/gallery_bottom5.png
        destination:
          uri: fb://group/prometheus/readability_gallery_bottom5.png
      - source:
          uri: file://results/readability/gallery_label_first.png
        destination:
          uri: fb://group/prometheus/readability_gallery_label_first.png
      - source:
          uri: file://results/readability/readability_map_w024.png
        destination:
          uri: fb://group/prometheus/readability_readability_map_w024.png
      - source:
          uri: file://results/readability/readability_map_w043.png
        destination:
          uri: fb://group/prometheus/readability_readability_map_w043.png
      - source:
          uri: file://results/readability/benchmark.json
        destination:
          uri: fb://group/prometheus/readability_benchmark.json
      - source:
          uri: file://results/readability/rank_summary.json
        destination:
          uri: fb://group/prometheus/readability_rank_summary.json

jobs:
  write-scripts:
    image:
      uri: docker://python:3.11
    mounts:
      /data: data
    resource:
      cpu:
        cores: 1
      memory:
        size: 1GB
    script: |
      #!/bin/bash
      set -euo pipefail
      D=/data/scripts/readability
      mkdir -p $D /data/results/readability
      rm -f /data/results/readability/scores_*.csv /data/results/readability/timing_*.json /data/results/readability/gpu_*.csv
      cat > $D/score.py <<'PYEOF'
      import argparse, csv, json, os, time
      import numpy as np, tifffile
      from PIL import Image
      Image.MAX_IMAGE_PIXELS = None
      ap = argparse.ArgumentParser()
      ap.add_argument("--backend", choices=["gpu", "cpu"], required=True)
      ap.add_argument("--segs", nargs="+", required=True)
      ap.add_argument("--official", action="store_true")
      args = ap.parse_args()
      R = os.environ.get("R", "/data/results/E6-bulk")
      SG = os.environ.get("SG", "/data/segments")
      O = os.environ.get("O", "/data/results/readability")
      os.makedirs(O, exist_ok=True)
      T = 512
      CK = ["ck010k", "ck040k", "ck075k"]
      LY = ["L04-20", "L06-22", "L08-24"]
      names = [c + "__" + l for c in CK for l in LY]
      FIELDS = ["segment", "source", "tile_row", "tile_col", "x0", "y0", "papyrus_frac", "ink_frac",
                "decisiveness", "contrast", "edge", "stroke", "agreement"]

      if args.backend == "gpu":
          import torch
          import torch.nn.functional as F
          dev = "cuda" if torch.cuda.is_available() else "cpu"
          KX = torch.tensor([[-1., 0., 1.], [-2., 0., 2.], [-1., 0., 1.]], device=dev)[None, None]
          KY = KX.transpose(2, 3).contiguous()
          _w = torch.rand(1, 1, 1024, 1024, device=dev)
          F.conv2d(_w, KX, padding=1); F.max_pool2d(_w, 3, stride=1, padding=1); torch.quantile(_w.flatten()[:1000], 0.9)
          if dev == "cuda":
              torch.cuda.synchronize()
      else:
          from scipy import ndimage

      def sync():
          if args.backend == "gpu" and dev == "cuda":
              torch.cuda.synchronize()

      def tsum(a, Hp, Wp):
          if args.backend == "gpu":
              a = F.pad(a, (0, Wp - a.shape[1], 0, Hp - a.shape[0]))
              return a.reshape(Hp // T, T, Wp // T, T).sum((1, 3)).double().cpu().numpy()
          a = np.pad(a, ((0, Hp - a.shape[0]), (0, Wp - a.shape[1])))
          return a.reshape(Hp // T, T, Wp // T, T).sum((1, 3), dtype=np.float64)

      def signals(q, v, disagree=None):
          H, W = q.shape
          Hp, Wp = -(-H // T) * T, -(-W // T) * T
          if args.backend == "gpu":
              vf = v.float()
              ink = (q > 0.5).float() * vf
              dec = ((q < 0.4) | (q > 0.6)).float() * vf
              gx = F.conv2d(q[None, None], KX, padding=1)[0, 0]
              gy = F.conv2d(q[None, None], KY, padding=1)[0, 0]
              mag = torch.sqrt(gx * gx + gy * gy)
              ve = (-F.max_pool2d(-vf[None, None], 3, stride=1, padding=1))[0, 0]
              sample = mag[ve > 0][::max(1, int((ve > 0).sum().item()) // 1000000)]
              thr = float(torch.quantile(sample.float(), 0.9).item()) if sample.numel() else 0.0
              edgep = ((mag > thr).float() * ve)
          else:
              vf = v.astype(np.float32)
              ink = (q > 0.5).astype(np.float32) * vf
              dec = ((q < 0.4) | (q > 0.6)).astype(np.float32) * vf
              gx = ndimage.correlate(q, np.array([[-1., 0., 1.], [-2., 0., 2.], [-1., 0., 1.]], np.float32), mode="constant")
              gy = ndimage.correlate(q, np.array([[-1., -2., -1.], [0., 0., 0.], [1., 2., 1.]], np.float32), mode="constant")
              mag = np.sqrt(gx * gx + gy * gy)
              ve = ndimage.minimum_filter(vf, size=3, mode="nearest")
              sel = mag[ve > 0]
              sample = sel[::max(1, sel.size // 1000000)]
              thr = float(np.quantile(sample, 0.9)) if sample.size else 0.0
              edgep = (mag > thr).astype(np.float32) * ve
          s_v = tsum(vf, Hp, Wp)
          s_ink = tsum(ink, Hp, Wp)
          s_dec = tsum(dec, Hp, Wp)
          s_qi = tsum(q * ink, Hp, Wp)
          s_qn = tsum(q * (vf - ink), Hp, Wp)
          s_mag = tsum(mag * ve, Hp, Wp)
          s_ve = tsum(ve, Hp, Wp)
          s_edge = tsum(edgep, Hp, Wp)
          s_dis = tsum(disagree, Hp, Wp) if disagree is not None else None
          sync()
          with np.errstate(divide="ignore", invalid="ignore"):
              out = {"papyrus_frac": s_v / (T * T),
                     "ink_frac": np.where(s_v > 0, s_ink / s_v, 0),
                     "decisiveness": np.where(s_v > 0, s_dec / s_v, 0),
                     "contrast": np.where((s_ink > 0) & (s_v - s_ink > 0), s_qi / np.maximum(s_ink, 1) - s_qn / np.maximum(s_v - s_ink, 1), 0),
                     "edge": np.where(s_ve > 0, s_mag / s_ve, 0),
                     "stroke": np.where(s_ink >= 0.01 * s_v, s_edge / np.maximum(s_ink, 1), 0)}
              if s_dis is not None:
                  out["agreement"] = np.where(s_v > 0, 1 - s_dis / s_v, 0)
          return out, thr

      def core_mask(valid_np, f=8, it=8):
          from scipy import ndimage as ndi
          h, w = valid_np.shape
          hh, ww = h // f, w // f
          sm = valid_np[:hh * f, :ww * f].reshape(hh, f, ww, f).all((1, 3))
          sm = ndi.binary_erosion(sm, iterations=it)
          out = np.zeros_like(valid_np)
          out[:hh * f, :ww * f] = np.repeat(np.repeat(sm, f, 0), f, 1)
          return out

      def to_dev(a):
          if args.backend == "gpu":
              return torch.from_numpy(np.ascontiguousarray(a)).to(dev)
          return a

      def rescale(p, do):
          if args.backend == "gpu":
              return torch.clamp((p - 0.25) / 0.5, 0, 1) * (p > 0).float() if do else p
          return np.clip((p - 0.25) / 0.5, 0, 1) * (p > 0) if do else p

      rows, timing = [], {"backend": args.backend, "tile_px": T, "segments": {}}
      for seg in args.segs:
          tl = time.time()
          raw = [tifffile.imread(R + "/" + seg + "/" + seg + "__" + n + ".tif").squeeze() for n in names]
          load_s = time.time() - tl
          m = (sum(a.astype(np.float32) for a in raw) / 9.0)
          core_np = core_mask(m > 0)
          pv = m[m > 0][::97] / 255.0
          p01, p50, p99 = [float(x) for x in np.percentile(pv, [1, 50, 99])]
          do_rescale = p01 >= 0.15
          info = {"files": [seg + "__" + n + ".tif" for n in names], "load_s": round(load_s, 3),
                  "raw_p01_p50_p99_of_mean9": [round(p01, 3), round(p50, 3), round(p99, 3)],
                  "rescale_applied": bool(do_rescale), "rescale": "(p-0.25)/0.5 clipped to [0,1]" if do_rescale else "none",
                  "edge_threshold_p90": {}}
          info["core_mask"] = "papyrus eroded by 64 px (8 x 8-px blocks); pixels outside are ignored"
          del m
          core = to_dev(core_np)
          sync()
          tc = time.time()
          acc = None
          vote = None
          valid = None
          for n, a in zip(names, raw):
              p = (to_dev(a).float() / 255.0) if args.backend == "gpu" else a.astype(np.float32) / 255.0
              v = p > 0
              valid = v if valid is None else (valid | v)
              acc = (p.clone() if args.backend == "gpu" else p.copy()) if acc is None else acc + p
              b = (p > 0.5)
              if args.backend == "gpu":
                  vote = b.to(torch.uint8) if vote is None else vote + b.to(torch.uint8)
              else:
                  vote = b.astype(np.uint8) if vote is None else vote + b.astype(np.uint8)
              s, thr = signals(rescale(p, do_rescale), v & core)
              info["edge_threshold_p90"][n] = thr
              for (r, c), _ in np.ndenumerate(s["papyrus_frac"]):
                  rows.append([seg, n, r, c, c * T, r * T] + [float(s[k][r, c]) for k in FIELDS[6:12]] + [""])
          mean9 = acc / 9.0
          if args.backend == "gpu":
              dis = ((vote > 0) & (vote < 9)).float() * valid.float()
          else:
              dis = ((vote > 0) & (vote < 9)).astype(np.float32) * valid
          q9 = rescale(mean9, do_rescale)
          s, thr = signals(q9, valid & core, dis * (core.float() if args.backend == "gpu" else core))
          sync()
          info["compute_s"] = round(time.time() - tc, 3)
          info["edge_threshold_p90"]["mean9"] = thr
          for (r, c), _ in np.ndenumerate(s["papyrus_frac"]):
              rows.append([seg, "mean9", r, c, c * T, r * T] + [float(s[k][r, c]) for k in FIELDS[6:13]])
          q9n = q9.cpu().numpy() if args.backend == "gpu" else q9
          if args.official:
              tifffile.imwrite(O + "/" + seg + "_mean9_q.tif", (np.clip(q9n, 0, 1) * 255).astype(np.uint8))
              import glob
              cands = [f for f in glob.glob(SG + "/" + seg + "/ink-detection/**/*", recursive=True)
                       if f.lower().endswith((".tif", ".tiff", ".png", ".jpg"))]
              if cands:
                  f = max(cands, key=os.path.getsize)
                  o = np.squeeze(tifffile.imread(f)) if f.lower().endswith((".tif", ".tiff")) else np.array(Image.open(f).convert("L"))
                  if o.ndim == 3:
                      o = o[0] if o.shape[0] < o.shape[-1] else o[..., 0]
                  o = o.astype(np.float32)
                  o = o / max(float(o.max()), 1e-6)
                  h, w = q9n.shape
                  og = np.array(Image.fromarray((o * 255).astype(np.uint8)).resize((w, h), Image.BILINEAR))
                  del o
                  tifffile.imwrite(O + "/" + seg + "_official_on_our_grid.tif", og)
                  oq = to_dev(og).float() / 255.0 if args.backend == "gpu" else og.astype(np.float32) / 255.0
                  so, _ = signals(oq, valid & core)
                  for (r, c), _ in np.ndenumerate(so["papyrus_frac"]):
                      rows.append([seg, "official", r, c, c * T, r * T] + [float(so[k][r, c]) for k in FIELDS[6:12]] + [""])
                  info["official_file"] = f
          timing["segments"][seg] = info
          del raw
      tag = args.backend + "_" + "_".join(args.segs)
      with open(O + "/scores_" + tag + ".csv", "w", newline="") as fh:
          wr = csv.writer(fh)
          wr.writerow(FIELDS)
          wr.writerows(rows)
      timing["device"] = (dev if args.backend == "gpu" else "cpu")
      json.dump(timing, open(O + "/timing_" + tag + ".json", "w"), indent=2)
      print(json.dumps(timing, indent=2))
      print("rows", len(rows))
      PYEOF
      cat > $D/rank.py <<'PYEOF'
      import csv, glob, json, os
      import numpy as np, tifffile
      from PIL import Image, ImageDraw
      Image.MAX_IMAGE_PIXELS = None
      O = os.environ.get("O", "/data/results/readability")
      T = 512
      W = {"contrast": 0.25, "decisiveness": 0.25, "edge": 0.2, "stroke": 0.15, "ink_band": 0.15, "agreement": 0.2}
      BAND = (0.03, 0.40)
      MINPAP = 0.5
      SIG = ["papyrus_frac", "ink_frac", "decisiveness", "contrast", "edge", "stroke", "agreement"]

      def load(pattern):
          rows = []
          for f in sorted(glob.glob(O + "/" + pattern)):
              for r in csv.DictReader(open(f)):
                  for k in SIG:
                      r[k] = float(r[k]) if r[k] != "" else None
                  for k in ["tile_row", "tile_col", "x0", "y0"]:
                      r[k] = int(r[k])
                  rows.append(r)
          return rows

      def key(r):
          return (r["segment"], r["source"], r["tile_row"], r["tile_col"])

      def pct(x):
          x = np.asarray(x, float)
          if len(x) < 2:
              return np.ones_like(x)
          return np.argsort(np.argsort(x, kind="stable"), kind="stable") / (len(x) - 1)

      def readability(rows, use_agreement):
          s = {k: pct([r[k] for r in rows]) for k in ["contrast", "decisiveness", "edge", "stroke"]}
          s["ink_band"] = np.array([1.0 if BAND[0] <= r["ink_frac"] <= BAND[1] else 0.0 for r in rows])
          ws = {k: W[k] for k in ["contrast", "decisiveness", "edge", "stroke", "ink_band"]}
          if use_agreement:
              s["agreement"] = pct([r["agreement"] for r in rows])
              ws["agreement"] = W["agreement"]
          tot = sum(ws.values())
          return sum(ws[k] * s[k] for k in ws) / tot

      def spearman(a, b):
          if len(a) < 3:
              return None
          return float(np.corrcoef(pct(a), pct(b))[0, 1])

      gpu = load("scores_gpu_*.csv")
      cpu = load("scores_cpu_*.csv")
      cmap = {key(r): r for r in cpu}
      diff = {k: 0.0 for k in SIG}
      matched = 0
      for r in gpu:
          c = cmap.get(key(r))
          if c is None:
              continue
          matched += 1
          for k in SIG:
              if r[k] is not None and c[k] is not None:
                  diff[k] = max(diff[k], abs(r[k] - c[k]))

      main = [r for r in gpu if r["source"] == "mean9" and r["papyrus_frac"] >= MINPAP]
      score = readability(main, True)
      for r, s in zip(main, score):
          r["readability"] = float(s)
      main.sort(key=lambda r: -r["readability"])
      with open(O + "/ranking_tiles.csv", "w", newline="") as fh:
          wr = csv.writer(fh)
          wr.writerow(["rank", "readability", "segment", "source", "tile_row", "tile_col", "x0", "y0"] + SIG)
          for i, r in enumerate(main, 1):
              wr.writerow([i, round(r["readability"], 4), r["segment"], "mean9 (9 E6 configs)", r["tile_row"], r["tile_col"], r["x0"], r["y0"]] + [round(r[k], 5) for k in SIG])

      segs = sorted({r["segment"] for r in main})
      pos = {(r["segment"], r["tile_row"], r["tile_col"]): r for r in main}
      cons, files, val = {}, [], {}
      sources = sorted({r["source"] for r in gpu if r["source"] not in ("mean9", "official")})
      for src in sources + ["mean9"]:
          rs = [r for r in gpu if r["source"] == src and (r["segment"], r["tile_row"], r["tile_col"]) in pos]
          if not rs:
              continue
          sc = readability(rs, False)
          for seg in segs:
              sel = [(r, s) for r, s in zip(rs, sc) if r["segment"] == seg]
              if not sel:
                  continue
              v = sorted((s for _, s in sel), reverse=True)
              top = v[:max(1, len(v) // 4)]
              files.append([seg, src, float(np.mean(top)), len(v)])
              if src != "mean9":
                  a = [s for _, s in sel]
                  b = [pos[(seg, r["tile_row"], r["tile_col"])]["readability"] for r, _ in sel]
                  cons.setdefault(seg, {})[src] = spearman(a, b)
      off = [r for r in gpu if r["source"] == "official" and (r["segment"], r["tile_row"], r["tile_col"]) in pos]
      if off:
          so = readability(off, False)
          for seg in segs:
              sel = [(r, s) for r, s in zip(off, so) if r["segment"] == seg]
              a = [s for _, s in sel]
              b = [pos[(seg, r["tile_row"], r["tile_col"])]["readability"] for r, _ in sel]
              val[seg] = {"tiles": len(sel), "spearman_ours_vs_official_readability": spearman(a, b)}
      files.sort(key=lambda x: -x[2])
      with open(O + "/ranking_files.csv", "w", newline="") as fh:
          wr = csv.writer(fh)
          wr.writerow(["rank", "file_score_top25pct_tiles", "segment", "source", "n_tiles"])
          for i, f in enumerate(files, 1):
              wr.writerow([i, round(f[2], 4), f[0], f[1], f[3]])

      lab = [r for r in main if BAND[0] <= r["ink_frac"] <= BAND[1]]
      lab.sort(key=lambda r: r["agreement"])
      with open(O + "/ranking_label_first.csv", "w", newline="") as fh:
          wr = csv.writer(fh)
          wr.writerow(["rank", "agreement", "segment", "tile_row", "tile_col", "x0", "y0", "readability"])
          for i, r in enumerate(lab, 1):
              wr.writerow([i, round(r["agreement"], 4), r["segment"], r["tile_row"], r["tile_col"], r["x0"], r["y0"], round(r["readability"], 4)])

      imgs, offs, lims = {}, {}, {}
      for seg in segs:
          p = O + "/" + seg + "_mean9_q.tif"
          if os.path.exists(p):
              a = tifffile.imread(p).astype(np.float32) / 255
              v = a[a > 0]
              lims[seg] = np.percentile(v, [50, 99.5]) if v.size else (0, 1)
              imgs[seg] = a
          p = O + "/" + seg + "_official_on_our_grid.tif"
          if os.path.exists(p):
              offs[seg] = tifffile.imread(p).astype(np.float32) / 255

      def crop(seg, r, which):
          src = imgs if which == "ours" else offs
          if seg not in src:
              return Image.new("L", (240, 240), 40)
          a = src[seg][r["y0"]:r["y0"] + T, r["x0"]:r["x0"] + T]
          if which == "ours":
              lo, hi = lims[seg]
              a = np.clip((a - lo) / max(hi - lo, 1e-6), 0, 1)
          return Image.fromarray((a * 255).astype(np.uint8)).resize((240, 240), Image.LANCZOS)

      def gallery(rs, path, title, label):
          cols = 4
          cw, chh = 490, 270
          rows_n = -(-len(rs) // cols) if rs else 1
          cv = Image.new("RGB", (cols * cw, rows_n * chh + 40), (0, 0, 0))
          d = ImageDraw.Draw(cv)
          d.text((10, 12), title, fill=(255, 255, 255))
          for i, r in enumerate(rs):
              x, y = (i % cols) * cw, 40 + (i // cols) * chh
              cv.paste(crop(r["segment"], r, "ours").convert("RGB"), (x + 5, y + 26))
              cv.paste(crop(r["segment"], r, "official").convert("RGB"), (x + 248, y + 26))
              d.text((x + 6, y + 6), label(i, r), fill=(255, 255, 255))
          cv.save(path)

      lbl = lambda i, r: "#%d %s x=%d y=%d R=%.2f  (ours | official)" % (i + 1, r["segment"], r["x0"], r["y0"], r["readability"])
      gallery(main[:20], O + "/gallery_top20.png", "Most readable tiles (512 px = 4.8 mm), ours = average of 9 configs", lbl)
      gallery(main[-5:][::-1], O + "/gallery_bottom5.png", "Least readable tiles", lambda i, r: "#%d %s x=%d y=%d R=%.2f" % (len(main) - i, r["segment"], r["x0"], r["y0"], r["readability"]))
      gallery(lab[:12], O + "/gallery_label_first.png", "Label first: ink present but the 9 configs disagree most",
              lambda i, r: "#%d %s x=%d y=%d agree=%.2f" % (i + 1, r["segment"], r["x0"], r["y0"], r["agreement"]))

      for seg in segs:
          if seg not in imgs:
              continue
          lo, hi = lims[seg]
          a = np.clip((imgs[seg] - lo) / max(hi - lo, 1e-6), 0, 1)
          sc = 1600 / a.shape[1]
          im = Image.fromarray((a * 255).astype(np.uint8)).resize((1600, int(a.shape[0] * sc)), Image.LANCZOS).convert("RGB")
          d = ImageDraw.Draw(im)
          for i, r in enumerate([r for r in lab if r["segment"] == seg][:10]):
              d.rectangle([r["x0"] * sc, r["y0"] * sc, (r["x0"] + T) * sc, (r["y0"] + T) * sc], outline=(255, 140, 0), width=3)
          for i, r in enumerate(main[:20]):
              if r["segment"] != seg:
                  continue
              d.rectangle([r["x0"] * sc, r["y0"] * sc, (r["x0"] + T) * sc, (r["y0"] + T) * sc], outline=(0, 230, 90), width=4)
              d.text((r["x0"] * sc + 4, r["y0"] * sc + 4), "#%d" % (i + 1), fill=(0, 255, 100))
          im.save(O + "/readability_map_" + seg + ".png")

      tg = [json.load(open(f)) for f in glob.glob(O + "/timing_gpu_*.json")]
      tc = [json.load(open(f)) for f in glob.glob(O + "/timing_cpu_*.json")]
      def tot(ts, k):
          return sum(s[k] for t in ts for s in t["segments"].values())
      util, pw = [], []
      for f in glob.glob(O + "/gpu_*.csv"):
          for line in open(f):
              p = [x.strip() for x in line.split(",")]
              try:
                  util.append(float(p[1]))
                  pw.append(float(p[2]))
              except Exception:
                  pass
      g_c, c_c = tot(tg, "compute_s"), tot(tc, "compute_s")
      g_l, c_l = tot(tg, "load_s"), tot(tc, "load_s")
      per_task = [sum(s["load_s"] + s["compute_s"] for s in t["segments"].values()) for t in tg]
      bench = {"segments": segs, "files_scored": 9 * len(segs), "sources_per_segment": "9 configs + mean9",
               "tiles_ranked": len(main), "tile_px": T,
               "gpu_device": [t.get("device") for t in tg],
               "gpu_compute_s": round(g_c, 3), "cpu_compute_s": round(c_c, 3),
               "compute_speedup": round(c_c / g_c, 1) if g_c else None,
               "gpu_load_s": round(g_l, 3), "cpu_load_s": round(c_l, 3),
               "end_to_end_gpu_s": round(g_l + g_c, 3), "end_to_end_cpu_s": round(c_l + c_c, 3),
               "end_to_end_speedup": round((c_l + c_c) / (g_l + g_c), 2) if (g_l + g_c) else None,
               "two_node_wall_s": round(max(per_task), 3) if per_task else None,
               "gpu_util_mean_pct": round(float(np.mean(util)), 1) if util else None,
               "gpu_power_mean_w": round(float(np.mean(pw)), 1) if pw else None,
               "gpu_vs_cpu_rows_matched": matched,
               "max_abs_diff_gpu_vs_cpu": {k: float(v) for k, v in diff.items()}}
      json.dump(bench, open(O + "/benchmark.json", "w"), indent=2)
      cons_sum = {seg: {"mean": float(np.mean([v for v in d.values() if v is not None])),
                        "min": float(np.min([v for v in d.values() if v is not None]))} for seg, d in cons.items()}
      summ = {"tile_px": T, "min_papyrus_frac": MINPAP, "weights": W, "ink_band": BAND,
              "rescale": {seg: t["segments"][seg]["rescale_applied"] for t in tg for seg in t["segments"]},
              "raw_percentiles_mean9": {seg: t["segments"][seg]["raw_p01_p50_p99_of_mean9"] for t in tg for seg in t["segments"]},
              "tiles_ranked": len(main), "consistency_config_vs_mean9_spearman": cons_sum,
              "consistency_per_config": cons, "validation_vs_official": val,
              "top10": [{"rank": i + 1, "segment": r["segment"], "x0": r["x0"], "y0": r["y0"], "readability": round(r["readability"], 3)} for i, r in enumerate(main[:10])],
              "label_first_top5": [{"segment": r["segment"], "x0": r["x0"], "y0": r["y0"], "agreement": round(r["agreement"], 3)} for r in lab[:5]]}
      json.dump(summ, open(O + "/rank_summary.json", "w"), indent=2)
      print(json.dumps(bench, indent=2))
      print(json.dumps(summ, indent=2))
      print("\nSUMMARY")
      print(" ranked %d tiles (%d px) across %s" % (len(main), T, ", ".join(segs)))
      print(" GPU compute %.2f s vs CPU %.2f s -> %sx; end-to-end %sx; two-node wall %s s" % (g_c, c_c, bench["compute_speedup"], bench["end_to_end_speedup"], bench["two_node_wall_s"]))
      print(" GPU vs CPU max diff:", {k: round(v, 6) for k, v in diff.items()})
      print(" consistency (configs vs mean9, Spearman):", {s: round(v["mean"], 3) for s, v in cons_sum.items()})
      print(" validation vs official (Spearman):", {s: (round(v["spearman_ours_vs_official_readability"], 3) if v["spearman_ours_vs_official_readability"] is not None else None) for s, v in val.items()})
      print(" top 5:", [(r["segment"], r["x0"], r["y0"], round(r["readability"], 2)) for r in main[:5]])
      print("wrote", sorted(f for f in os.listdir(O) if f.endswith((".csv", ".png", ".json")) and not f.startswith(("scores_", "timing_", "gpu_"))))
      print("DONE")
      PYEOF
      echo "score.py lines: $(wc -l < $D/score.py) (expect 192)"
      echo "rank.py lines: $(wc -l < $D/rank.py) (expect 224)"

  score-gpu:
    depends-on:
      - name: write-scripts
        status: FINISHED
    image:
      uri: docker://nvcr.io/nvidia/pytorch:25.10-py3
    mounts:
      /data: data
    resource:
      cpu:
        cores: 8
      memory:
        size: 48GB
      devices:
        nvidia.com/gpu: 1
    task-array:
      start: 1
      end: 2
      concurrency: 2
    script: |
      #!/bin/bash
      set -uo pipefail
      SEGS=(w024 w043)
      SEG=${SEGS[$((FB_TASK_ID-1))]}
      O=/data/results/readability
      source /data/venv/bin/activate
      nvidia-smi --query-gpu=timestamp,utilization.gpu,power.draw \
        --format=csv,noheader,nounits -l 1 > $O/gpu_$SEG.csv 2>/dev/null &
      SMI=$!
      python /data/scripts/readability/score.py --backend gpu --segs $SEG --official
      RC=$?
      kill $SMI 2>/dev/null
      exit $RC

  score-cpu:
    depends-on:
      - name: write-scripts
        status: FINISHED
    image:
      uri: docker://nvcr.io/nvidia/pytorch:25.10-py3
    mounts:
      /data: data
    resource:
      cpu:
        cores: 8
      memory:
        size: 48GB
    script: |
      #!/bin/bash
      set -uo pipefail
      source /data/venv/bin/activate
      python /data/scripts/readability/score.py --backend cpu --segs w024 w043

  rank:
    depends-on:
      - name: score-gpu
        status: FINISHED
      - name: score-cpu
        status: FINISHED
    image:
      uri: docker://nvcr.io/nvidia/pytorch:25.10-py3
    mounts:
      /data: data
    resource:
      cpu:
        cores: 4
      memory:
        size: 32GB
    script: |
      #!/bin/bash
      set -uo pipefail
      source /data/venv/bin/activate
      python /data/scripts/readability/rank.py
