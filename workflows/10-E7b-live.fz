version: v4

volumes:
  data:
    use: team5
    name: prometheus-data

jobs:
  mask:
    image:
      uri: docker://nvcr.io/nvidia/pytorch:25.10-py3
    mounts:
      /data: data
    resource:
      cpu:
        cores: 4
      memory:
        size: 48GB
    script: |
      #!/bin/bash
      set -uo pipefail
      source /data/venv/bin/activate
      cat > /tmp/m.py <<'PYEOF'
      import json, os
      import numpy as np, tifffile
      R = os.environ.get("R", "/data/results/E6-bulk")
      O = os.environ.get("O", "/data/results/E7b-live")
      T = 256
      B = 4
      seg = "w024"
      CK = ["ck010k", "ck040k", "ck075k"]
      LY = ["L04-20", "L06-22", "L08-24"]
      PILOT = ["ck075k__L06-22", "ck010k__L06-22"]
      names = [c + "__" + l for c in CK for l in LY]
      S = [tifffile.imread(R + "/" + seg + "/" + seg + "__" + n + ".tif").squeeze() for n in names]
      h, w = S[0].shape
      H, W = -(-h // T) * T, -(-w // T) * T
      S = np.stack([np.pad(a.astype(np.float32) / 255, ((0, H - h), (0, W - w))) for a in S])
      valid = S.max(0) > 0
      pi = [names.index(p) for p in PILOT]
      d = np.abs(S[pi[0]] - S[pi[1]]) * valid
      n = valid.reshape(H // T, T, W // T, T).sum((1, 3))
      sc = d.reshape(H // T, T, W // T, T).sum((1, 3)) / np.maximum(n, 1)
      usable = n >= 0.1 * T * T
      k = int(round((B - 2) / 7.0 * usable.sum()))
      idx = np.argsort(-np.where(usable, sc, -1).ravel())[:k]
      m = np.zeros(usable.size, bool)
      m[idx] = True
      m = np.repeat(np.repeat(m.reshape(usable.shape), T, 0), T, 1)[:h, :w]
      os.makedirs(O + "/" + seg, exist_ok=True)
      tifffile.imwrite(O + "/" + seg + "/mask_B4.tif", (m * 255).astype(np.uint8))
      info = {"segment": seg, "budget_full_passes": B, "tile_px": T, "tiles_selected": k,
              "usable_tiles": int(usable.sum()), "mask_pct_of_image": float(100 * m.mean()),
              "mask_pct_of_valid": float(100 * (m & valid[:h, :w]).sum() / valid.sum())}
      json.dump(info, open(O + "/" + seg + "/mask_info.json", "w"), indent=2)
      print(json.dumps(info, indent=2))
      PYEOF
      echo "mask script lines: $(wc -l < /tmp/m.py) (expect 33)"
      python /tmp/m.py

  infer:
    depends-on:
      - name: mask
        status: FINISHED
    image:
      uri: docker://nvcr.io/nvidia/pytorch:25.10-py3
    mounts:
      /data: data
    resource:
      cpu:
        cores: 12
      memory:
        size: 48GB
      devices:
        nvidia.com/gpu: 1
    task-array:
      start: 1
      end: 7
      concurrency: 2
    script: |
      #!/bin/bash
      set -uo pipefail
      SEG=w024
      REST=(ck010k__L04-20 ck010k__L08-24 ck040k__L04-20 ck040k__L06-22 ck040k__L08-24 ck075k__L04-20 ck075k__L08-24)
      CFG=${REST[$((FB_TASK_ID-1))]}
      CK=${CFG%%__*}
      LY=${CFG##*__}
      LS=$((10#${LY:1:2}))
      LE=$((LS+17))
      case $CK in
        ck010k) STEP=010000 ;;
        ck040k) STEP=040000 ;;
        ck075k) STEP=075000 ;;
      esac
      CKPT=/data/models/ink_9um/hybrid_3d2d-seed42/step-$STEP.pth
      OUT=/data/results/E7b-live/$SEG
      NAME=${SEG}__${CFG}__masked
      echo "task=$FB_TASK_ID config=$CFG layers $LS..$((LE-1)) mask=$OUT/mask_B4.tif"
      source /data/venv/bin/activate
      cd /data/villa/ink-detection
      nvidia-smi --query-gpu=timestamp,utilization.gpu,power.draw \
        --format=csv,noheader,nounits -l 1 > $OUT/gpu_$NAME.csv 2>/dev/null &
      SMI=$!
      START=$(date +%s)
      python -m koine_machines.inference.infer /data/segments/$SEG/surface.zarr "$CKPT" \
        $OUT/$NAME.tif --no-compile --num-workers 8 --batch-size 128 \
        --layer-start $LS --layer-end $LE --mask-path $OUT/mask_B4.tif > $OUT/log_$NAME.txt 2>&1
      RC=$?
      END=$(date +%s)
      kill $SMI 2>/dev/null
      grep -E "mask|Mask|Selected source layer|Infer: 100" $OUT/log_$NAME.txt | tail -6
      NL=$(grep -m1 "Selected source layer" $OUT/log_$NAME.txt | grep -o "indices=\[[^]]*\]" | tr ',' '\n' | wc -l)
      printf '{"experiment":"E7b-live","task":%s,"config":"%s","n_layers":%s,"start":%d,"end":%d,"wall_clock_s":%d,"rc":%d}\n' \
        $FB_TASK_ID $CFG $NL $START $END $((END-START)) $RC | tee $OUT/timing_$CFG.json
      if [ $RC -ne 0 ] || [ ! -f $OUT/$NAME.tif ] || [ "$NL" -ne 17 ]; then
        echo "FAILED (rc=$RC, layers=$NL)"; tail -30 $OUT/log_$NAME.txt; exit 1
      fi

  compare:
    depends-on:
      - name: infer
        status: FINISHED
    image:
      uri: docker://nvcr.io/nvidia/pytorch:25.10-py3
    mounts:
      /data: data
    resource:
      cpu:
        cores: 4
      memory:
        size: 48GB
    script: |
      #!/bin/bash
      set -uo pipefail
      source /data/venv/bin/activate
      cat > /tmp/c.py <<'PYEOF'
      import json, os, glob
      import numpy as np, tifffile
      R = os.environ.get("R", "/data/results/E6-bulk")
      O = os.environ.get("O", "/data/results/E7b-live")
      seg = "w024"
      CK = ["ck010k", "ck040k", "ck075k"]
      LY = ["L04-20", "L06-22", "L08-24"]
      PILOT = ["ck075k__L06-22", "ck010k__L06-22"]
      names = [c + "__" + l for c in CK for l in LY]
      REST = [n for n in names if n not in PILOT]
      d = O + "/" + seg
      m = tifffile.imread(d + "/mask_B4.tif").squeeze() > 0
      full = {n: tifffile.imread(R + "/" + seg + "/" + seg + "__" + n + ".tif").squeeze().astype(np.float32) / 255 for n in names}
      S = np.stack([full[n] for n in names])
      valid = S.max(0) > 0
      ref = S.mean(0)
      refB = ref > 0.5
      hard = valid & (S.std(0) > 0.2)
      masked = {}
      chk = {}
      for n in REST:
          a = tifffile.imread(d + "/" + seg + "__" + n + "__masked.tif").squeeze().astype(np.float32) / 255
          masked[n] = a
          inside = m & valid
          chk[n] = {"corr_inside_mask": float(np.corrcoef(a[inside], full[n][inside])[0, 1]),
                    "max_abs_diff_inside_0_255": float(255 * np.abs(a[inside] - full[n][inside]).max()),
                    "pct_nonzero_outside_mask": float(100 * (a[~m] > 0).mean())}
      pilot = (full[PILOT[0]] + full[PILOT[1]]) / 2
      nine = (full[PILOT[0]] + full[PILOT[1]] + sum(masked[n] for n in REST)) / 9
      est = np.where(m, nine, pilot)
      wrong = (est > 0.5) != refB
      quality = {"call_err_pct": float(100 * wrong[valid].mean()),
                 "call_err_on_contested_pct": float(100 * wrong[hard].mean())}
      e6 = {}
      for f in glob.glob(R + "/" + seg + "/timing_*.json"):
          x = json.load(open(f))
          e6[x["name"].split("__", 1)[1]] = x["wall_clock_s"]
      tm = [json.load(open(f)) for f in glob.glob(d + "/timing_*.json")]
      mk = {x["config"]: x["wall_clock_s"] for x in tm}
      full_rest = sum(e6[n] for n in REST)
      masked_rest = sum(mk[n] for n in REST)
      pilot_s = sum(e6[n] for n in PILOT)
      mean_full = sum(e6.values()) / len(e6)
      adaptive_s = pilot_s + masked_rest
      uniform4_s = 4 * mean_full
      all9_s = sum(e6[n] for n in names)
      wall = max(x["end"] for x in tm) - min(x["start"] for x in tm)
      cost = {"masked_runs_gpu_s": masked_rest, "same_7_runs_full_gpu_s": full_rest,
              "gpu_time_saved_on_7_runs_pct": round(100 * (1 - masked_rest / full_rest), 1),
              "per_run_masked_s": mk, "per_run_full_s": {n: e6[n] for n in REST},
              "adaptive_total_gpu_s": adaptive_s, "uniform_4_pass_gpu_s": round(uniform4_s, 1),
              "full_9_config_gpu_s": all9_s,
              "adaptive_vs_full9_saved_pct": round(100 * (1 - adaptive_s / all9_s), 1),
              "adaptive_vs_uniform4_ratio": round(adaptive_s / uniform4_s, 3),
              "masked_phase_wall_clock_s_2_nodes": wall}
      info = json.load(open(d + "/mask_info.json"))
      out = {"experiment": "E7b-live", "mask": info, "cost_measured": cost,
             "quality_vs_full_9": quality, "masked_output_check": chk}
      json.dump(out, open(d + "/metrics.json", "w"), indent=2)
      print(json.dumps(out, indent=2))
      print("\nSUMMARY")
      print(" mask covers %.1f%% of the papyrus" % info["mask_pct_of_valid"])
      print(" 7 masked runs: %d GPU-s vs %d GPU-s full  -> %.1f%% saved" % (masked_rest, full_rest, cost["gpu_time_saved_on_7_runs_pct"]))
      print(" adaptive total %d GPU-s | uniform 4-pass %.0f | full 9-config %d" % (adaptive_s, uniform4_s, all9_s))
      print(" wrong calls vs full result: overall %.2f%%, contested %.2f%%" % (quality["call_err_pct"], quality["call_err_on_contested_pct"]))
      print(" masked output matches full run inside mask: min corr %.5f" % min(v["corr_inside_mask"] for v in chk.values()))
      print("DONE")
      PYEOF
      echo "compare script lines: $(wc -l < /tmp/c.py) (expect 67)"
      python /tmp/c.py
